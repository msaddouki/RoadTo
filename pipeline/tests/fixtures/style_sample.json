{
  "version": 8,
  "name": "sample",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.example.org/planet",
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    },
    "relief": {
      "type": "raster",
      "tiles": ["https://tiles.example.org/relief/{z}/{x}/{y}.png"],
      "tileSize": 256
    }
  },
  "sprite": "https://tiles.example.org/sprites/ofm",
  "glyphs": "https://tiles.example.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#f8f4f0"}},
    {"id": "relief", "type": "raster", "source": "relief"},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water"},
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {"text-field": "{name}", "text-font": ["Noto Sans Regular"]}
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["step", ["zoom"], ["literal", ["Noto Sans Regular"]], 10, ["literal", ["Noto Sans Bold"]]]
      }
    }
  ]
}
